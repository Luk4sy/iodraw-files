        <mxCell id="Da5EV44nQ5C0AoBqTrzy-9" value="文本（prompt）的工作流" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="260" y="140" width="160" height="30" as="geometry" />
